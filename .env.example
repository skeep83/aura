# ===== Обязательное =====
# Токен бота от @BotFather
BOT_TOKEN=
# Домен приложения (A-запись на IP сервера). HTTPS выпустится автоматически.
APP_DOMAIN=roulette.example.com
PUBLIC_URL=https://roulette.example.com
# Публичный IP сервера (для TURN)
PUBLIC_IP=203.0.113.10
# Хост TURN — можно тот же домен
TURN_HOST=roulette.example.com
# Секреты: openssl rand -hex 32
TURN_SECRET=
MODERATION_TOKEN=

# ===== Бренд и поддержка =====
APP_NAME=Aura
# @username бота без @ (для ссылок на комнаты и приглашения; если пусто — узнаётся автоматически)
BOT_USERNAME=
# Короткое имя Mini App из @BotFather (/newapp). Если задано, ссылки вида t.me/bot/app?startapp=…
MINIAPP_SHORT_NAME=
# Telegram ID админов через запятую (узнать свой: @userinfobot) — /stats /ban /unban /refund
ADMIN_IDS=
# Токен админ-API для панели Aura Admin (openssl rand -hex 32); пусто — API выключен
ADMIN_API_TOKEN=
# Куда писать по оплате (обязательно для платежей в Telegram)
SUPPORT_CONTACT=@your_support

# ===== Цены Premium в Telegram Stars =====
PRICE_WEEK_STARS=75
PRICE_MONTH_STARS=199
PRICE_SALUTE5_STARS=25
PRICE_SALUTE20_STARS=79

# ===== Рост и удержание =====
# Часовой пояс аудитории (для Aura Hour и серий дней), часы от UTC
TZ_OFFSET_HOURS=3
# Aura Hour: ежедневное событие с короткими раундами и напоминанием за 5 минут
EVENT_TIME=21:00
EVENT_MINUTES=60
ROUND_SECONDS=180
# Бесплатные подборы по фильтру пола в день (дальше — Premium)
FREE_FILTER_PER_DAY=10
# Premium обоим за приглашённого друга, сутки
REFERRAL_PREMIUM_DAYS=1
# Награда Premium на сутки за каждые N дней серии
STREAK_REWARD_EVERY=7
# Оценка +aura/−aura предлагается после разговора не короче N секунд
RATE_MIN_SECONDS=15
# Нити: ходов до финала по типам (история / вопрос миру / пожелание), срок жизни в днях, часов без передачи до возврата в пул
THREAD_HOPS_STORY=12
THREAD_HOPS_QUESTION=20
THREAD_HOPS_WISH=10
THREAD_TTL_DAYS=7
THREAD_STUCK_HOURS=48
# «Вдвоём с одного телефона»: через сколько мс двоих можно свести с одиночкой; Duo 2×2: сколько ждать соединения всех четверых
PAIR_RELAX_MS=25000
DUO_CONN_TIMEOUT_MS=20000
# custom_emoji_id для статуса «в Aura» (Telegram Premium). Пусто — кнопка скрыта
EMOJI_STATUS_ID=

# ===== Модерация =====
# Порог NSFW (0..1): выше — нарушение
NSFW_THRESHOLD=0.85
# Как часто клиент присылает кадр на проверку, мс
FRAME_INTERVAL_MS=4000
# Страйков до бана и длительность бана, часы
STRIKES_TO_BAN=3
STRIKE_BAN_HOURS=24
# Уникальных жалоб за 7 дней до бана на 7 дней
REPORTS_TO_BAN=3
# Внешний сервис модерации (например, на GPU-сервере). Пусто — встроенный контейнер moderation.
# MODERATION_URL=http://10.0.0.5:8000
# Возраст: вероятность «младше 20» по лицу, при которой кадр считается подозрительным (2 из 3 кадров → блок)
MINOR_THRESHOLD=0.8
AGE_BLOCK_HOURS=24

# ===== TURN от Cloudflare Realtime (если нет своего coturn) =====
# CF_TURN_KEY_ID=
# CF_TURN_TOKEN=

# ===== Вход в браузере =====
# 1 = браузер без Telegram получает анонимный профиль web-* и сессию на 30 дней (HOM-31)
WEB_ANON=1
# Способы входа через запятую (telegram; google/yandex/vk/email — по мере готовности провайдеров).
# ПУСТО = вход на сайте выключен целиком: /auth/* отдаёт 404, cookie не выдаются, кнопок входа нет.
# Для telegram нужен /setdomain у @BotFather и заполненный BOT_USERNAME.
AUTH_PROVIDERS=
# 1 = cookie без флага Secure (только локальный http). НА ПРОДЕ НЕ ВКЛЮЧАТЬ.
# AUTH_COOKIE_INSECURE=1
# Дополнительная соль подписи cookie состояния OAuth
# SESSION_SALT=

# ===== Технические =====
# 0 — бэкенд отдаёт только API (статику раздаёт nginx). По умолчанию отдаёт и статику (удобно локально)
# SERVE_STATIC=0
# Адрес быстрого туннеля Cloudflare узнаётся у cloudflared автоматически (вместо PUBLIC_URL)
# PUBLIC_URL_DISCOVER=http://tunnel:2000/quicktunnel

# ===== Только для локальной отладки =====
# 1 = пускать без Telegram и выдавать Premium без оплаты. НА ПРОДЕ НЕ ВКЛЮЧАТЬ.
DEV_ALLOW_ANON=0
